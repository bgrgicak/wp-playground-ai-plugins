#!/bin/sh
# Validate the Claude Code plugin manifest before committing.
# Enable with: git config core.hooksPath .githooks

if command -v claude >/dev/null 2>&1; then
  echo "Validating Claude Code plugin..."
  claude plugin validate .
else
  echo "Skipping Claude Code plugin validation (claude CLI not installed)"
fi

if command -v gemini >/dev/null 2>&1; then
  echo "Validating Gemini extension..."
  gemini extensions validate .
else
  echo "Skipping Gemini extension validation (gemini CLI not installed)"
fi
